# Server Configuration
PORT=3000
NODE_ENV=production

# Private Internal Admin Recipients (Server-side only, never sent to browser)
ADMIN_EMAILS=dikaiosunepvtltd@gmail.com,admin@dikaiosune.in
FROM_EMAIL="Dikaiosune Mega Project" <admin@dikaiosune.in>

# SMTP Credentials
# For Gmail SMTP:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password (16 characters)
# 3. Fill in SMTP_USER (your email) and SMTP_PASS (the app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
